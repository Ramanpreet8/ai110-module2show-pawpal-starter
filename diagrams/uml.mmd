classDiagram
    class Task {
        +str description
        +time scheduled_time
        +int duration_minutes
        +str frequency
        +str priority
        +bool is_complete
        +mark_complete() None
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task: Task) None
    }

    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() List~Task~
    }

    class Scheduler {
        +build_schedule(owner: Owner, available_minutes: int) List~Task~
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : cares for
    Scheduler ..> Owner : reads tasks from

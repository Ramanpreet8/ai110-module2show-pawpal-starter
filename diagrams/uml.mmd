classDiagram
    class Task {
        +str description
        +time scheduled_time
        +int duration_minutes
        +str frequency
        +str priority
        +date due_date
        +bool is_complete
        +mark_complete() None
        +next_occurrence(completed_on: date) Task
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task: Task) None
    }

    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() List~Task~
    }

    class Scheduler {
        +sort_by_time(tasks: List~Task~) List~Task~
        +filter_tasks(owner: Owner, pet_name: str, is_complete: bool) List~Task~
        +complete_task(pet: Pet, task: Task, completed_on: date) Task
        +detect_conflicts(owner: Owner) List~str~
        +build_schedule(owner: Owner, available_minutes: int) List~Task~
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : cares for
    Scheduler ..> Owner : reads tasks from
